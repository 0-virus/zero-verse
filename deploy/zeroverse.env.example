# Copy to /etc/zeroverse/zeroverse.env (root-owned mode 0600), not into the release.
# systemd EnvironmentFile values do NOT expand references to other variables.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
PUBLIC_ORIGIN=https://REPLACE_DOMAIN
CORS_ALLOWED_ORIGINS=https://REPLACE_DOMAIN
AUTH_ALLOWED_ORIGINS=https://REPLACE_DOMAIN

DB_URL="jdbc:mysql://REPLACE_AIVEN_HOST:REPLACE_AIVEN_PORT/defaultdb?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
DB_USERNAME=REPLACE_DATABASE_USER
DB_PASSWORD="REPLACE_DATABASE_PASSWORD"
DB_SSL_TRUSTSTORE_URL=file:/etc/zeroverse/aiven-truststore.p12
DB_SSL_TRUSTSTORE_TYPE=PKCS12
DB_SSL_TRUSTSTORE_PASSWORD="REPLACE_TRUSTSTORE_PASSWORD"

JWT_SECRET_BASE64=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
VIEWER_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_AS_TEXT

S3_BUCKET=zero-verse-s3
S3_REGION=ap-northeast-2
# Production identity must be authorized for this separate prefix before deployment.
S3_PREFIX=zeroverse/prod/
AWS_ACCESS_KEY_ID=REPLACE_PRODUCTION_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_PRODUCTION_SECRET_ACCESS_KEY
# For temporary credentials also supply AWS_SESSION_TOKEN and manage their expiry.
